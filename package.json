{
  "name": "@codex/shared",
  "version": "0.2.0",
  "description": "Shared utilities, middleware, and types for web services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./routes": {
      "import": "./dist/routes/index.js",
      "types": "./dist/routes/index.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1.11.0",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "hono": "^4.13.8",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmanzanarez/codex-shared-libraries.git"
  },
  "author": "David Manzanarez",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "sideEffects": false,
  "private": true
}
